# Sway Config File
# Translated from i3 config for Wayland

set $mod Mod4

# Font for window titles and bar
font pango:monospace 12

# Samsung C49RG9x 5120x1440 120Hz Output Config

# Autostart desktop applications via XDG
exec dex --autostart --environment sway

# Network Manager applet
exec nm-applet --indicator

# Volume controls
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Start a terminal
bindsym $mod+Return exec alacritty

# Kill focused window
bindsym $mod+Shift+q kill

# Application Launcher (Replaced dmenu with rofi-wayland)
# bindsym $mod+d exec rofi -show drun
bindsym $mod+d exec fuzzel

# Navigation (Vim-style & Arrow Keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+y split h
bindsym $mod+v split v

# Fullscreen mode
bindsym $mod+f fullscreen toggle

# Layout styles
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Parent / Child container focus
bindsym $mod+a focus parent

# Define Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Configuration Management
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit Sway?' -B 'Yes, exit Sway' 'swaymsg exit'

# Window Resizing Mode
mode "resize" {
        bindsym h resize shrink width 10 px
        bindsym j resize grow height 10 px
        bindsym k resize shrink height 10 px
        bindsym l resize grow width 10 px

        bindsym Left resize shrink width 10 px
        bindsym Down resize grow height 10 px
        bindsym Up resize shrink height 10 px
        bindsym Right resize grow width 10 px

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Status Bar
# bar {
#         status_command i3status
# }
# bar {
#         swaybar_command waybar
# }
exec_always killall waybar; waybar > /dev/null 2>&1 &

# CUSTOM STUFF BELOW

# Removes window title bars / borders
#default_border pixel 0
#default_floating_border pixel 0

## WALLPAPER (Replaced feh with swaybg)
exec_always swaybg -i /home/tameem/Pictures/witcher.jpg -m fill

## Faster key repeating (Handled natively by Sway)
input * {
    repeat_delay 200
    repeat_rate 30
}

## Windows Compositor
# Removed picom: Sway handles compositing natively out of the box with zero tearing.

# Suspend
bindsym $mod+Shift+period exec systemctl suspend

# Audio GUI Control
bindsym $mod+Shift+a exec pavucontrol

# SCREENSHOTS (Replaced maim/xclip with grim/slurp/wl-copy)

# F10: Select area -> Copy directly to clipboard
bindsym F10 exec grim -g "$(slurp)" - | wl-copy

# Shift+F10: Select area -> Save directly to ~/screenshots
bindsym Shift+F10 exec grim -g "$(slurp)" "$HOME/screenshots/shot_$(date +%s).png"




# Ensure default windows open tiled
for_window [app_id=".*"] floating disable
for_window [class=".*"] floating disable

exec_always autotiling


output DP-4 mode 5120x1440@119.970Hz position 0,0 scale 1 adaptive_sync on

# needed for webrtc apps to share windows or whole monitor
exec /usr/lib/xdg-desktop-portal-wlr &


# Lock screen after 5 minutes, turn off screen after 10 minutes
exec swayidle -w \
    timeout 300 'swaylock -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -c 000000'


# Enable XWayland primary selection support
exec_always wl-paste --type text --watch clipman store --no-persist


# Minimal window borders
default_border pixel 1
default_floating_border pixel 1
gaps inner 4
gaps outer 0

# Colors:                border   bg       text     indicator child_border
client.focused           #00ff00  #000000  #00ff00  #00ff00   #00ff00
client.focused_inactive  #003300  #000000  #007700  #003300   #003300
client.unfocused         #002200  #000000  #005500  #002200   #002200
client.urgent            #ff0000  #000000  #ffffff  #ff0000   #ff0000
